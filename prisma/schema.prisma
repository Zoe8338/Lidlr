generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  code       String    @id
  name       String
  host       String
  locale     String
  assortment String
  currency   String
  enabled    Boolean   @default(true)
  listings   Listing[]
}

model Product {
  erpNumber     String         @id
  // Lidl IAN article numbers (e.g. ["494209"]) captured from the search API
  ians          String?
  title         String
  titleEn       String?
  // product description + spec list, in the source language and translated
  description   String?
  descriptionEn String?
  specs         String?
  specsEn       String?
  brandName     String?
  brandSlug     String?
  category      String?
  imageUrl      String?
  images        String?
  // filenames (data/images/<sha256>.<ext>) of archived copies of imageUrl+images
  storedImages  String?
  firstSeen     DateTime       @default(now())
  lastSeen      DateTime       @default(now())
  removed       Boolean        @default(false)
  listings        Listing[]
  snapshots       Snapshot[]
  trackings       Tracking[]
  notifications   Notification[]
  manuals         Manual[]
  manualCheckedAt DateTime?
}

// One row per product per country shop
model Listing {
  id             Int        @id @default(autoincrement())
  product        Product    @relation(fields: [erpNumber], references: [erpNumber])
  erpNumber      String
  countryCode    String
  country        Country    @relation(fields: [countryCode], references: [code])
  url            String?
  currentPrice   Float?
  oldPrice       Float?
  currency       String?
  online         Boolean?
  stockText      String?
  stockOk        Boolean    @default(false)
  promo          String?
  priceUpdatedAt DateTime?
  snapshots      Snapshot[]

  @@unique([erpNumber, countryCode])
  @@index([countryCode, currentPrice])
  @@index([erpNumber])
}

model Snapshot {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [erpNumber], references: [erpNumber])
  listing     Listing  @relation(fields: [listingId], references: [id])
  listingId   Int
  erpNumber   String
  countryCode String
  price       Float?
  oldPrice    Float?
  available   Boolean?
  promo       String?
  // ECB reference rate EUR->local currency on takenAt (null = unknown, use current rate)
  fxRate      Float?
  takenAt     DateTime @default(now())

  @@index([listingId, takenAt])
}

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  notifyEmail    Boolean        @default(true)
  notifyWhatsapp Boolean        @default(false)
  whatsappPhone  String?
  whatsappKey    String?
  createdAt      DateTime       @default(now())
  trackings      Tracking[]
  notifications  Notification[]
  loginTokens    LoginToken[]
}

// One-time login codes; only a sha256 hash of the code is stored.
model LoginToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Tracking {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  product        Product  @relation(fields: [erpNumber], references: [erpNumber], onDelete: Cascade)
  erpNumber      String
  countryCode    String?
  maxPrice       Float?
  offerOnly      Boolean?
  onlineOnly     Boolean?
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([userId, erpNumber])
}

model Notification {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  product      Product? @relation(fields: [erpNumber], references: [erpNumber], onDelete: SetNull)
  erpNumber    String?
  title        String
  message      String
  viaEmail     Boolean  @default(true)
  viaWhatsapp  Boolean  @default(false)
  emailed      Boolean  @default(false)
  whatsapp     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([erpNumber, message])
}

// One row per archived Lidl leaflet (weekly flyer) per country
model Leaflet {
  id          Int            @id @default(autoincrement())
  countryCode String
  flyerId     String         @unique
  name        String
  title       String?
  validFrom   DateTime?
  validUntil  DateTime?
  coverUrl    String?
  pdfUrl      String?
  viewUrl     String?
  pages       Int?
  sizeBytes   Int?
  sha256      String?
  pdfStored   Boolean        @default(false)
  archivedAt  DateTime?
  fetchedAt   DateTime       @default(now())
  offers      LeafletOffer[]

  @@index([countryCode, validFrom])
}

// One offer tile from a leaflet (from Lidl's flyer JSON API)
// An archived product manual: the official PDF (usually manuals.sit-connect.com)
// plus its sha256-deduped copy under data/manuals/.
model Manual {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [erpNumber], references: [erpNumber], onDelete: Cascade)
  erpNumber String
  url       String
  title     String
  language  String?
  sha256    String?
  sizeBytes Int?
  stored    Boolean  @default(false)
  storedPath String?
  fetchedAt DateTime @default(now())

  @@unique([erpNumber, url])
  @@index([erpNumber])
}

model LeafletOffer {
  id        Int      @id @default(autoincrement())
  leaflet   Leaflet  @relation(fields: [leafletId], references: [id], onDelete: Cascade)
  leafletId Int
  offerKey  String   @unique
  erpNumber String?
  title     String
  brand     String?
  price     Float?
  currency  String?
  imageUrl  String?
  url       String?

  @@index([leafletId])
  @@index([erpNumber])
}

model CrawlRun {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  source       String
  countries    Int
  newItems     Int       @default(0)
  priceChanges Int       @default(0)
  errors       Int       @default(0)
  notes        String?
}
