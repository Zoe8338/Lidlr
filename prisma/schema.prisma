generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  code       String    @id
  name       String
  host       String
  locale     String
  assortment String
  currency   String
  enabled    Boolean   @default(true)
  listings   Listing[]
}

model Product {
  erpNumber     String         @id
  title         String
  titleEn       String?
  brandName     String?
  brandSlug     String?
  category      String?
  imageUrl      String?
  images        String?
  firstSeen     DateTime       @default(now())
  lastSeen      DateTime       @default(now())
  removed       Boolean        @default(false)
  listings      Listing[]
  snapshots     Snapshot[]
  trackings     Tracking[]
  notifications Notification[]
}

// One row per product per country shop
model Listing {
  id             Int        @id @default(autoincrement())
  product        Product    @relation(fields: [erpNumber], references: [erpNumber])
  erpNumber      String
  countryCode    String
  country        Country    @relation(fields: [countryCode], references: [code])
  url            String?
  currentPrice   Float?
  oldPrice       Float?
  currency       String?
  online         Boolean?
  stockText      String?
  stockOk        Boolean    @default(false)
  promo          String?
  priceUpdatedAt DateTime?
  snapshots      Snapshot[]

  @@unique([erpNumber, countryCode])
  @@index([countryCode, currentPrice])
  @@index([erpNumber])
}

model Snapshot {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [erpNumber], references: [erpNumber])
  listing     Listing  @relation(fields: [listingId], references: [id])
  listingId   Int
  erpNumber   String
  countryCode String
  price       Float?
  oldPrice    Float?
  available   Boolean?
  promo       String?
  takenAt     DateTime @default(now())

  @@index([listingId, takenAt])
}

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  notifyEmail    Boolean        @default(true)
  notifyWhatsapp Boolean        @default(false)
  whatsappPhone  String?
  whatsappKey    String?
  createdAt      DateTime       @default(now())
  trackings      Tracking[]
  notifications  Notification[]
  loginTokens    LoginToken[]
}

// One-time login codes; only a sha256 hash of the code is stored.
model LoginToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Tracking {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product  @relation(fields: [erpNumber], references: [erpNumber], onDelete: Cascade)
  erpNumber String
  createdAt DateTime @default(now())

  @@unique([userId, erpNumber])
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  product   Product? @relation(fields: [erpNumber], references: [erpNumber], onDelete: SetNull)
  erpNumber String?
  title     String
  message   String
  emailed   Boolean  @default(false)
  whatsapp  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One row per archived Lidl leaflet (weekly flyer) per country
model Leaflet {
  id          Int       @id @default(autoincrement())
  countryCode String
  flyerId     String    @unique
  name        String
  title       String?
  validFrom   DateTime?
  validUntil  DateTime?
  coverUrl    String?
  pdfUrl      String?
  viewUrl     String?
  pages       Int?
  sizeBytes   Int?
  sha256      String?
  pdfStored   Boolean   @default(false)
  archivedAt  DateTime?
  fetchedAt   DateTime  @default(now())

  @@index([countryCode, validFrom])
}

model CrawlRun {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  source       String
  countries    Int
  newItems     Int       @default(0)
  priceChanges Int       @default(0)
  errors       Int       @default(0)
  notes        String?
}
