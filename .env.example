DATABASE_URL="file:./dev.db"
# Optional alert delivery via Resend (https://resend.com). Without it, alerts are stored and shown in the UI.
RESEND_API_KEY=""
ALERT_FROM_EMAIL="lidlr@example.com"
# Crawl behaviour
CRAWL_DELAY_MS="400"
CRAWL_FETCHSIZE="200"
# Auto-translate product names as they are crawled (default target: English)
AUTO_TRANSLATE="1"
TRANSLATE_TARGET="en"
# Optional: random string used to sign login sessions; otherwise auto-generated in data/auth-secret
AUTH_SECRET=""
