DATABASE_URL="file:./dev.db"
# Email delivery via Resend (https://resend.com). REQUIRED for the passwordless
# login-code flow and tracking notifications. Without it, login codes are shown
# in the UI (dev fallback only) and notifications stay pending.
RESEND_API_KEY=""
ALERT_FROM_EMAIL="lidlr@example.com"
# Public URL of the site (used in emails/notifications links)
SITE_URL="http://localhost:3000"
# Crawl behaviour
CRAWL_DELAY_MS="400"
CRAWL_FETCHSIZE="200"
# Auto-translate product names as they are crawled (default target: English)
# Chain: Mistral AI first (if key set), bundled LibreTranslate sidecar finishes
AUTO_TRANSLATE="1"
TRANSLATE_TARGET="en"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
# Admin dashboard (/admin): comma-separated list of emails that may use it.
# Leave empty to disable the dashboard entirely. Only these emails see the
# Admin link and can trigger jobs / edit or delete leaflets.
ADMIN_EMAILS=""
# Bump if seasonal leaflets (e.g. Christmas, valid ~2 months) should be
# archived instead of being skipped as "evergreen":
# LEAFLET_MAX_VALIDITY_DAYS="70"
# Optional: random string used to sign login sessions; otherwise auto-generated in data/auth-secret
AUTH_SECRET=""
# Optional: protects POST /api/crawl when set (send x-crawl-secret header)
CRAWL_SECRET=""
# Set to "1" to disable the built-in weekly crawl / daily notification scheduler
SCHEDULER_DISABLED=""
# Leaflet archive: download PDF copies of each country's weekly flyers into
# data/leaflets/ (0 = only store metadata + covers)
ARCHIVE_LEAFLET_PDF="1"
# Optional cap on leaflets kept per country per fetch. 0 (default) = archive
# every leaflet the sites offer — distinct seasonal catalogs that share a name
# (e.g. several "Folheto Especial" editions) are all kept.
LEAFLET_MAX_PER_COUNTRY="0"
# Cap on products fetched per brand query per crawl (crawler reports queries
# that hit this cap as "truncated" in the crawl summary/notes).
CRAWL_MAX_PER_BRAND="3000"
# Skip "leaflets" valid longer than this many days (evergreen catalogs, not weekly flyers)
LEAFLET_MAX_VALIDITY_DAYS="45"
# Refuse to archive PDFs larger than this (MB)
LEAFLET_MAX_PDF_MB="60"
# Email delivery via your own SMTP server (preferred; e.g. Gmail app password,
# your domain mail server). Takes precedence over Resend when set.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="0"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# MAIL_FROM="you@gmail.com"
# Product manuals archive: fetch the "Anleitungen & Downloads" PDFs off each
# product page and store sha256-deduped copies in data/manuals/ (runs after the
# weekly crawl; HOME page shows both official + archived links).
# Products actually checked per run (crawls stay fast; the rest drain over runs)
MANUAL_FETCH_PER_RUN="25"
# Max manuals kept per product
MANUAL_MAX_PER_PRODUCT="6"
# Refuse to archive manuals larger than this (MB)
MANUAL_MAX_PDF_MB="20"
